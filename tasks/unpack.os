// tasks/unpack.os - Разборка .cfe / .cf в читаемые исходники
// Протестировано: OneScript v2.0.1, Windows 10, PowerShell 5.1
//
// API OneScript v2.0.1:
//   ТекущийСценарий().Источник  - полный путь к файлу скрипта
//   Новый Файл(Путь).Путь       - каталог файла (со слешем)
//   Новый Файл(Путь).Существует() - проверка существования
//   АргументыКоманднойСтроки    - свойство (не функция!), ФиксированныйМассив
//
// Запуск (PowerShell из корня проекта):
//   tools\oscript\oscript.exe tasks\unpack.os --src tools\ext.cfe --dst src\cfe\
//   tools\oscript\oscript.exe tasks\unpack.os --src tools\base.cf  --dst tools\cf_src\
//   tools\oscript\oscript.exe tasks\unpack.os --build --src src\cfe\ --dst src\build\out\ext.cfe
//
// Лог: tools\logs\unpack.log

// -- Глобальные переменные ----------------------------------------
Перем КореньПроекта;
Перем V8UnpackExe;
Перем PythonExe;
Перем ПапкаЛогов;
Перем ФайлЛога;

// -- Вспомогательные функции --------------------------------------

Процедура ОбеспечитьКаталог(Знач Путь)
    Если НЕ Новый Файл(Путь).Существует() Тогда
        СоздатьКаталог(Путь);
    КонецЕсли;
КонецПроцедуры

// -- Логирование --------------------------------------------------

Процедура ЗаписатьЛог(Знач Уровень, Знач Сообщение)
    Штамп = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd ЧФ=HH:mm:ss");
    Строка = "[" + Штамп + "] [" + Уровень + "] " + Сообщение;
    Сообщить(Строка);
    Попытка
        ОбеспечитьКаталог(ПапкаЛогов);
        ФСТекст = Новый ЗаписьТекста(ФайлЛога, КодировкаТекста.UTF8, Истина);
        ФСТекст.ЗаписатьСтроку(Строка);
        ФСТекст.Закрыть();
    Исключение
    КонецПопытки;
КонецПроцедуры

Процедура Инфо(Знач Сообщение)
    ЗаписатьЛог("INFO ", Сообщение);
КонецПроцедуры

Процедура Ошибка(Знач Сообщение)
    ЗаписатьЛог("ERROR", Сообщение);
КонецПроцедуры

// -- Основные функции ---------------------------------------------

Функция КомандаДоступна(Знач Команда)
    Попытка
        ЗапуститьПриложение(Команда + " --version", , Истина);
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция АвтоМетод()
    Если КомандаДоступна("gitsync") Тогда
        Возврат "gitsync";
    ИначеЕсли Новый Файл(PythonExe).Существует() Тогда
        Возврат "saby";
    Иначе
        Возврат "binary";
    КонецЕсли;
КонецФункции

Процедура ОбеспечитьV8UnpackExe()
    Если Новый Файл(V8UnpackExe).Существует() Тогда
        Возврат;
    КонецЕсли;
    Инфо("v8unpack.exe не найден, загружаю...");
    СкриптЗагрузки = ОбъединитьПути(КореньПроекта, "tools", "get-v8unpack.ps1");
    ЗапуститьПриложение("powershell -ExecutionPolicy Bypass -File """ + СкриптЗагрузки + """", , Истина);
    Если НЕ Новый Файл(V8UnpackExe).Существует() Тогда
        ВызватьИсключение "v8unpack.exe не загружен. Запустите: powershell -ExecutionPolicy Bypass -File tools\get-tools.ps1";
    КонецЕсли;
КонецПроцедуры

// -- Методы разборки ---------------------------------------------

Процедура РазобратьGitsync(Знач ЦФЕ, Знач Папка)
    Инфо("Метод: gitsync");
    ОбеспечитьКаталог(Папка);
    Команда = "gitsync export """ + Папка + """";
    Инфо("Команда: " + Команда);
    Попытка
        ЗапуститьПриложение(Команда, , Истина);
        Инфо("OK -> " + Папка);
    Исключение
        Ошибка("gitsync: " + ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура РазобратьSaby(Знач ЦФЕ, Знач Папка)
    // saby v8unpack -E делает полный pipeline за один шаг:
    // бинарная распаковка + декодирование имён + организация исходников
    Инфо("Метод: saby v8unpack (Python) v1.2.6+");
    Инфо("Прямая разборка: " + ЦФЕ + " -> " + Папка);
    ОбеспечитьКаталог(Папка);
    Попытка
        Кмд = """" + PythonExe + """ -m v8unpack -E """ + ЦФЕ + """ """ + Папка + """";
        Инфо("Команда: " + Кмд);
        ЗапуститьПриложение(Кмд, , Истина);
        Инфо("OK -> " + Папка);
    Исключение
        Ошибка("ОШИБКА saby: " + ОписаниеОшибки());
        Ошибка("Файл: " + ЦФЕ);
        Ошибка("python.exe: " + PythonExe);
        Ошибка("Проверьте: " + PythonExe + " -m v8unpack --help");
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура РазобратьБинарный(Знач ЦФЕ, Знач Папка)
    Инфо("Метод: binary - ВНИМАНИЕ: бинарные блоки, НЕ читаемый код!");
    ОбеспечитьV8UnpackExe();
    ОбеспечитьКаталог(Папка);
    Попытка
        Кмд = """" + V8UnpackExe + """ -E """ + ЦФЕ + """ """ + Папка + """";
        Инфо("Команда: " + Кмд);
        ЗапуститьПриложение(Кмд, , Истина);
        Инфо("OK (бинарные блоки) -> " + Папка);
    Исключение
        Ошибка("ОШИБКА binary: " + ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура Собрать(Знач ПапкаИсходников, Знач ПутьРезультата)
    Инфо("Сборка .cfe: " + ПапкаИсходников + " -> " + ПутьРезультата);
    РодПапка = ОбъединитьПути(ПутьРезультата, "..");
    ОбеспечитьКаталог(РодПапка);
    Попытка
        Если КомандаДоступна("gitsync") Тогда
            ЗапуститьПриложение("gitsync build """ + ПапкаИсходников + """ """ + ПутьРезультата + """", , Истина);
        Иначе
            ОбеспечитьV8UnpackExe();
            ЗапуститьПриложение("""" + V8UnpackExe + """ -B """ + ПапкаИсходников + """ """ + ПутьРезультата + """", , Истина);
        КонецЕсли;
        Инфо("OK -> " + ПутьРезультата);
    Исключение
        Ошибка("ОШИБКА сборки: " + ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// -- Точка входа (после всех процедур) ---------------------------

// Получаем каталог скрипта через ТекущийСценарий().Источник + Новый Файл().Путь
// Скрипт в tasks/, корень проекта на уровень выше
КаталогСкрипта    = Новый Файл(ТекущийСценарий().Источник).Путь;
КореньПроекта     = Новый Файл(КаталогСкрипта + "..").ПолноеИмя;
V8UnpackExe       = ОбъединитьПути(КореньПроекта, "tools", "v8unpack.exe");
PythonExe         = ОбъединитьПути(КореньПроекта, "tools", "python", "python.exe");
ПапкаЛогов        = ОбъединитьПути(КореньПроекта, "tools", "logs");
ФайлЛога          = ОбъединитьПути(ПапкаЛогов, "unpack.log");

Инфо("=== unpack.os запущен ===");
Инфо("Корень проекта: " + КореньПроекта);

// АргументыКоманднойСтроки - свойство (не функция!), тип ФиксированныйМассив
Аргументы = АргументыКоманднойСтроки;
// ФиксированныйМассив -> строка для лога
АргСтр = "";
Для каждого А Из Аргументы Цикл
    АргСтр = АргСтр + А + " ";
КонецЦикла;
Инфо("Аргументы: " + СокрП(АргСтр));

Режим      = "unpack";
Метод      = "";
Источник   = "";
Назначение = "";

Индекс = 0;
Пока Индекс < Аргументы.Количество() Цикл
    А = Аргументы[Индекс];
    Если А = "--src" Тогда
        Индекс = Индекс + 1;
        Источник = Аргументы[Индекс];
    ИначеЕсли А = "--dst" Тогда
        Индекс = Индекс + 1;
        Назначение = Аргументы[Индекс];
    ИначеЕсли А = "--method" Тогда
        Индекс = Индекс + 1;
        Метод = НРег(Аргументы[Индекс]);
    ИначеЕсли А = "--build" Тогда
        Режим = "build";
    КонецЕсли;
    Индекс = Индекс + 1;
КонецЦикла;

Попытка
    Если Режим = "build" Тогда
        Если ПустаяСтрока(Источник) ИЛИ ПустаяСтрока(Назначение) Тогда
            ВызватьИсключение "Укажите: --build --src <папка> --dst <файл.cfe>";
        КонецЕсли;
        Собрать(Источник, Назначение);
    Иначе
        Если ПустаяСтрока(Источник) Тогда
            Инфо("Использование:");
            Инфо("  tools\\oscript\\oscript.exe tasks\\unpack.os --src tools\\ext.cfe --dst src\\cfe\\");
            Инфо("  ... --method gitsync|saby|binary");
            ВызватьИсключение "Не указан --src";
        КонецЕсли;
        Если ПустаяСтрока(Назначение) Тогда
            Назначение = "src\cfe\";
        КонецЕсли;
        ЭфМетод = ?(НЕ ПустаяСтрока(Метод), Метод, АвтоМетод());
        Инфо("Выбран метод: " + ЭфМетод);
        Если      ЭфМетод = "gitsync" Тогда РазобратьGitsync(Источник, Назначение);
        ИначеЕсли ЭфМетод = "saby"    Тогда РазобратьSaby(Источник, Назначение);
        Иначе                               РазобратьБинарный(Источник, Назначение);
        КонецЕсли;
    КонецЕсли;
    Инфо("=== unpack.os завершён успешно ===");
Исключение
    Ошибка("=== unpack.os ОШИБКА: " + ОписаниеОшибки() + " ===");
    Ошибка("Лог: " + ФайлЛога);
    ВызватьИсключение;
КонецПопытки;
